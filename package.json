{
  "name": "sceneforge",
  "private": true,
  "version": "1.0.0",
  "description": "SCENEFORGE \u2014 a personal film production studio: screenplay, scenes, storyboards, shot lists, characters, scheduling and more.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
